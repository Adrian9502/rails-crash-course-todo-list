<%= form_with(model: todo, class: "mt-8") do |form| %>
  <% if todo.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-2xl p-5 mb-6 animate-fade-in">
      <div class="flex gap-3">
        <div class="flex-shrink-0">
          <div class="w-8 h-8 bg-red-100 rounded-full flex items-center justify-center">
            <svg class="h-5 w-5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
          </div>
        </div>
        <div class="flex-1">
          <h3 class="text-sm font-semibold text-red-800 mb-2">
            <%= pluralize(todo.errors.count, "error") %> found:
          </h3>
          <ul class="space-y-1 text-sm text-red-700">
            <% todo.errors.each do |error| %>
              <li class="flex items-start gap-2">
                <span class="text-red-400 mt-0.5">•</span>
                <span><%= error.full_message %></span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="space-y-6">
    <div>
      <%= form.label :title, class: "block text-sm font-bold text-gray-700 mb-3" do %>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
          Task Title
        </span>
      <% end %>
      <%= form.text_field :title, 
          placeholder: "What do you need to do?",
          class: ["block w-full px-5 py-4 rounded-2xl border-2 shadow-sm transition-all text-base",
                  {"border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-100": todo.errors[:title].none?, 
                   "border-red-300 focus:border-red-500 focus:ring-4 focus:ring-red-100": todo.errors[:title].any?}] %>
    </div>

    <div class="bg-gray-50 rounded-2xl p-5 border-2 border-gray-200">
      <div class="flex items-center gap-3">
        <%= form.checkbox :completed, 
            class: ["h-6 w-6 rounded-lg border-2 border-gray-300 text-blue-600 focus:ring-4 focus:ring-blue-100 cursor-pointer transition-all",
                    {"focus:ring-red-100": todo.errors[:completed].any?}] %>
        <%= form.label :completed, class: "text-base font-semibold text-gray-700 cursor-pointer select-none" do %>
          <span class="flex items-center gap-2">
            Mark as completed
            <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
          </span>
        <% end %>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 pt-2">
      <%= form.submit class: "flex-1 px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white font-bold rounded-2xl shadow-lg hover:shadow-xl transition-all cursor-pointer transform hover:scale-[1.02]" %>
      <%= link_to "Cancel", todos_path, class: "px-8 py-4 bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold rounded-2xl transition-all text-center" %>
    </div>
  </div>
<% end %>
